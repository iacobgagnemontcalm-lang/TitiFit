# Firebase — copier vers .env.local :  cp .env.example .env.local
#
# Projet TitiFit : titifit-ff0a6
# Les trois valeurs déjà remplies se déduisent de l'ID de projet.
# Il reste TROIS champs à copier depuis la console :
#
#   Console Firebase → ⚙️ Paramètres du projet → Tes applications → icône </>
#   (si aucune app Web n'existe, crée-la : TitiFit utilise le SDK JavaScript,
#    donc une app WEB — pas iOS/Android, et aucun google-services.json)
#
# Vérifie ensuite :  npm run check:firebase
#
# Sans ces variables, TitiFit démarre quand même : l'app bascule sur le backend
# local (AsyncStorage uniquement) et les comptes sont désactivés.
#
# Ne mets ni guillemets ni espaces autour du signe =.

# --- Déjà connus (dérivés du projet) ----------------------------------------
EXPO_PUBLIC_FIREBASE_PROJECT_ID=titifit-ff0a6
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=titifit-ff0a6.firebaseapp.com
# Vérifie la valeur exacte dans la console : les projets récents utilisent
# .firebasestorage.app, les plus anciens .appspot.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=titifit-ff0a6.firebasestorage.app

# --- À copier depuis la console ---------------------------------------------
# apiKey, commence par "AIza"
EXPO_PUBLIC_FIREBASE_API_KEY=
# messagingSenderId, le numéro de projet (12 chiffres)
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# appId, de la forme 1:123456789012:web:abc123def456
EXPO_PUBLIC_FIREBASE_APP_ID=
