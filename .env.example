# Firebase — copier vers .env.local et remplir avec les valeurs de la console
# Firebase (Paramètres du projet → Tes applications → Configuration du SDK).
#
# Sans ces variables, TitiFit démarre quand même : l'app bascule sur le backend
# local (AsyncStorage uniquement) et les comptes sont désactivés.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
